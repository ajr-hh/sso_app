// Humanaut SOS — Supabase Postgres

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  age         String?
  contactInfo String?
  whyMatters  String?
  motivators  String   @default("Remember why")
  coachStyle  String   @default("marcus")
  lastCraving String?
  lastFlex    String   @default("Mid")
  streak      Int      @default(0)
  createdAt   DateTime @default(now())

  goals          Goal[]
  dailyTasks     DailyTask[]
  journalEntries JournalEntry[]
  photos         ReinforcementPhoto[]
  rewards        Reward[]
  accountability AccountabilityContact[]
  sosEvents      SosEvent[]
  pastAttempts   PastAttempt[]
  kryptonite     KryptoniteFood[]
  communityPosts CommunityPost[]
  restaurants    FavoriteRestaurant[]
  challenges     Challenge[]
  aliases        FoodAlias[]
}

model Goal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  order     Int       @default(0)
  deletedAt DateTime?

  @@index([userId, deletedAt, order], map: "Goal_active_user_order_idx")
}

model DailyTask {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean   @default(false)
  date      DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, deletedAt, date], map: "DailyTask_active_user_date_idx")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String
  text      String
  createdAt DateTime @default(now())
}

model PastAttempt {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  deletedAt DateTime?

  @@index([userId, deletedAt], map: "PastAttempt_active_user_idx")
}

// User always chooses the photo AND writes the caption.
model ReinforcementPhoto {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String
  caption    String
  tag        String
  mode       String
  createdAt  DateTime @default(now())
}

model Reward {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   String
  rewardLabel String
  icon        String  @default("redeem")
  statusLabel String?
  earned      Boolean @default(false)
}

model AccountabilityContact {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  contactInfo String
  initials    String  @default("")
  priority    Int     @default(0)
  optedIn     Boolean @default(false)
}

model SosEvent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  path          String
  reinforcement String?
  createdAt     DateTime  @default(now())
  followUpAt    DateTime?
}

model KryptoniteFood {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String
  order  Int              @default(0)
  swaps  KryptoniteSwap[]
}

model KryptoniteSwap {
  id     String         @id @default(cuid())
  foodId String
  food   KryptoniteFood @relation(fields: [foodId], references: [id], onDelete: Cascade)
  label  String
}

model CommunityPost {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName String
  initials   String
  text       String
  createdAt  DateTime @default(now())
}

model FavoriteRestaurant {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  filter String
  dishes RestaurantDish[]
}

model RestaurantDish {
  id           String             @id @default(cuid())
  restaurantId String
  restaurant   FavoriteRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
}

model Challenge {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationDays Int     @default(30)
  buyIn        Int     @default(20)
  members      Int     @default(1)
  invited      Boolean @default(false)
}

model FoodAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  craving   String
  level     String
  swapTitle String
  swapSub   String
  createdAt DateTime @default(now())
}
